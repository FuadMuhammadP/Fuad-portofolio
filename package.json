{
  "name": "fuad-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio Fuad — HTML + Tailwind CSS v4",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --watch",
    "build": "tailwindcss -i ./assets/css/input.css -o ./assets/css/output.css --minify",
    "fonts": "node scripts/copy-fonts.mjs",
    "postinstall": "node scripts/copy-fonts.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
